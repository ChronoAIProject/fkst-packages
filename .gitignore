# Local, machine-specific config. Tracked template lives in .fkst/env.example.
/.fkst/packages
/.fkst/local-packages
/.fkst/run/
/.fkst/env
/.fkst/host-profiles/*.env
!/.fkst/host-profiles/example.env

# Python bytecode
__pycache__/
*.pyc

# Local-only Claude Code harness state + secrets (machine-specific, never tracked)
.env
.claude/scheduled_tasks.lock
.claude/worktrees/
